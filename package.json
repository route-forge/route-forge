{
  "name": "route-forge",
  "private": true,
  "version": "0.0.0",
  "description": "Laravel 命名路由的全链路解决方案（分级懒加载 + 类型安全 + 拦截器）",
  "license": "MIT",
  "author": "阿杰很厉害 <506907958@qq.com>",
  "homepage": "https://github.com/route-forge/route-forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/route-forge/route-forge.git"
  },
  "bugs": {
    "url": "https://github.com/route-forge/route-forge/issues"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "publish:core": "cd packages/core && pnpm publish --access public",
    "publish:vue": "cd packages/vue && pnpm publish --no-git-checks",
    "publish:react": "cd packages/react && pnpm publish --no-git-checks",
    "publish:only": "pnpm run publish:core && pnpm run publish:vue && pnpm run publish:react",
    "publish:build": "turbo run typecheck test build && pnpm run publish:only"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3"
  }
}
