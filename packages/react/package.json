{
  "name": "@route-forge/react",
  "version": "0.2.1",
  "description": "Route Forge 的 React 集成：Provider + hooks（useForge/useForgeApi/useForgeLevel/useForgeRoute/useForgeByPrefix）",
  "license": "MIT",
  "author": "阿杰很厉害 <506907958@qq.com>",
  "homepage": "https://github.com/xyj2156/route-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyj2156/route-forge.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/xyj2156/route-forge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@route-forge/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
