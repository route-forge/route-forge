{
  "name": "@route-forge/core",
  "version": "1.1.0",
  "description": "框架无关的命名路由客户端核心：分级懒加载、隔离缓存、并发去重、拦截器",
  "license": "MIT",
  "author": "阿杰很厉害 <506907958@qq.com>",
  "homepage": "https://github.com/xyj2156/route-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyj2156/route-forge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xyj2156/route-forge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "bin": {
    "route-forge-codegen": "./dist/codegen.js"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "axios": "^1.6.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
