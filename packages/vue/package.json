{
  "name": "@route-forge/vue",
  "version": "2.1.0",
  "description": "Route Forge 的 Vue 3 集成：插件 + composable（useForge/useForgeApi/useForgeRoute）/ Vue 3 integration for Laravel named routes: plugin + composables (useForge / useForgeApi / useForgeRoute)",
  "keywords": [
    "laravel",
    "named-routes",
    "vue",
    "vue3",
    "composables",
    "url-generation",
    "api-client",
    "typescript",
    "route-forge"
  ],
  "license": "MIT",
  "author": "阿杰很厉害 <506907958@qq.com>",
  "homepage": "https://github.com/route-forge/route-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/route-forge/route-forge.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/route-forge/route-forge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README_en.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "vitest": "4.1.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@route-forge/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
