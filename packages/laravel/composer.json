{
    "name": "route-forge/laravel",
    "description": "Laravel 命名路由的分级懒加载后端：路由扫描、tier 分配（->tier() / Route::group / config match / classifier / fallback）、元信息端点、缓存",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "route",
        "named-route",
        "spa",
        "tier",
        "lazy-loading"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "RouteForge\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RouteForge\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RouteForge\\Laravel\\ForgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
