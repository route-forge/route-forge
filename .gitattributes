# Packagist 发布时排除无关文件（npm/前端/工具链/文档/CI）
# 仅保留：根 composer.json + packages/laravel/* + LICENSE
# 这样用户 `composer require route-forge/laravel` 下载的 tarball 只含 Laravel 包相关代码

# —— npm / pnpm / turbo / TypeScript 工具链 ——
packages/core/                       export-ignore
packages/vue/                        export-ignore
package.json                         export-ignore
pnpm-lock.yaml                       export-ignore
pnpm-workspace.yaml                 export-ignore
turbo.json                           export-ignore
tsconfig.base.json                   export-ignore
.npmrc                               export-ignore

# —— 文档 / 计划 ——
.docs/                               export-ignore
schedule.md                          export-ignore

# —— CI / IDE 配置 ——
.github/                             export-ignore
.editorconfig                        export-ignore
.trae/                               export-ignore
